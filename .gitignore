# Môi trường Python và cấu hình cục bộ
.venv/
venv/
.env
.env.*
!.env.example

# Cache và file sinh tự động
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Dữ liệu: chỉ quản lý placeholder để giữ cấu trúc thư mục
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep

# File hệ điều hành
.DS_Store
Thumbs.db

